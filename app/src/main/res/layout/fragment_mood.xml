<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.mood.MoodFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="기분 관리 📊"
            style="@style/TextAppearance.Kkobak.Title"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kkobak.Card.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_record_mood"
                    style="@style/Widget.Kkobak.Button"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="✨ 지금 기분 기록하기"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorOnPrimaryContainer"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_log_mood_tab"
                        style="@style/Widget.Kkobak.Button"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="📝 로그 추가"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        android:textColor="?attr/colorOnSecondaryContainer"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_history_mood_tab"
                        style="@style/Widget.Kkobak.Button"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="📊 기록 보기"
                        android:textSize="14sp"
                        android:layout_marginStart="6dp"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        android:textColor="?attr/colorOnSecondaryContainer"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mood_chart_container"
            style="@style/Widget.Kkobak.Card.Surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <LinearLayout
                    android:id="@+id/chart_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📈 기분 변화 추이"
                        style="@style/TextAppearance.Kkobak.Label"
                        android:layout_marginBottom="16dp"/>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/mood_line_chart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/empty_state_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/empty_state_lottie"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        app:lottie_rawRes="@raw/empty_box"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_speed="0.8"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="아직 기록된 기분이 없어요.\n오늘 하루는 어떠셨나요? 😊"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="16dp"/>
                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
